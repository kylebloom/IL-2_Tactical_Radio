<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Renders the radio's art from src/Il2Radio.App/Brand.cs, so the icon and README images match the window:
      dotnet run (project tools/BrandArt)
    writes src/Il2Radio.App/app.ico, docs/images/banner.png and docs/images/emblem.png. Run it after changing Brand.cs.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Il2Radio.App\Brand.cs" Link="Brand.cs" />
  </ItemGroup>

</Project>
