// Points at IL-2's own radio recordings in YOUR install; nothing is copied or redistributed.
// Key meanings are inferred from file names (and, for the English packs, speech recognition): see "Recorded radio voices" in docs/FEASIBILITY.md.
// Check by ear with: Il2Radio.Diag voice-check --country 103
{
  "name": "IL-2 American pilots (game recordings)",
  "language": "en-US",
  "countries": [
    103
  ],
  "root": "{il2}/data/Audio/radio/usa",
  "speakers": [
    "actor101",
    "actor102",
    "actor103",
    "actor104",
    "actor105"
  ],
  "preprocessed": true,
  "clips": {
    "class.fighter": "{speaker}/const/fighter.ogg",
    "class.fighters": "{speaker}/const/fighters.ogg",
    "class.bomber": "{speaker}/const/bomber.ogg",
    "class.bombers": "{speaker}/const/bombers.ogg",
    "class.attack": "{speaker}/const/attackpl.ogg",
    "class.attacks": "{speaker}/const/attackpls.ogg",
    "class.recon": "{speaker}/const/recon.ogg",
    "class.recons": "{speaker}/const/recons.ogg",
    "class.transport": "{speaker}/const/transport.ogg",
    "number.1": "{speaker}/varCallsign/cn_01.ogg",
    "number.2": "{speaker}/varCallsign/cn_02.ogg",
    "number.3": "{speaker}/varCallsign/cn_03.ogg",
    "number.4": "{speaker}/varCallsign/cn_04.ogg",
    "number.5": "{speaker}/varCallsign/cn_05.ogg",
    "number.6": "{speaker}/varCallsign/cn_06.ogg",
    "number.7": "{speaker}/varCallsign/cn_07.ogg",
    "number.8": "{speaker}/varCallsign/cn_08.ogg",
    "number.9": "{speaker}/varCallsign/cn_09.ogg",
    "number.10": "{speaker}/varCallsign/cn_10.ogg",
    "number.11": "{speaker}/varCallsign/cn_11.ogg",
    "number.12": "{speaker}/varCallsign/cn_12.ogg",
    "number.13": "{speaker}/varCallsign/cn_13.ogg",
    "number.14": "{speaker}/varCallsign/cn_14.ogg",
    "number.15": "{speaker}/varCallsign/cn_15.ogg",
    "number.16": "{speaker}/varCallsign/cn_16.ogg",
    "number.17": "{speaker}/varCallsign/cn_17.ogg",
    "number.18": "{speaker}/varCallsign/cn_18.ogg",
    "number.19": "{speaker}/varCallsign/cn_19.ogg",
    "number.20": "{speaker}/varCallsign/cn_20.ogg",
    "group": "{speaker}/const/grp.ogg",
    "pair": "{speaker}/const/pair.ogg",
    "clock.1": "{speaker}/varDir/01clock.ogg",
    "clock.2": "{speaker}/varDir/02clock.ogg",
    "clock.3": "{speaker}/varDir/03clock.ogg",
    "clock.4": "{speaker}/varDir/04clock.ogg",
    "clock.5": "{speaker}/varDir/05clock.ogg",
    "clock.6": "{speaker}/varDir/06clock.ogg",
    "clock.7": "{speaker}/varDir/07clock.ogg",
    "clock.8": "{speaker}/varDir/08clock.ogg",
    "clock.9": "{speaker}/varDir/09clock.ogg",
    "clock.10": "{speaker}/varDir/10clock.ogg",
    "clock.11": "{speaker}/varDir/11clock.ogg",
    "clock.12": "{speaker}/varDir/12clock.ogg",
    "compass.n": "{speaker}/varDir/to_n.ogg",
    "compass.ne": "{speaker}/varDir/to_ne.ogg",
    "compass.e": "{speaker}/varDir/to_e.ogg",
    "compass.se": "{speaker}/varDir/to_se.ogg",
    "compass.s": "{speaker}/varDir/to_s.ogg",
    "compass.sw": "{speaker}/varDir/to_sw.ogg",
    "compass.w": "{speaker}/varDir/to_w.ogg",
    "compass.nw": "{speaker}/varDir/to_nw.ogg",
    "range.close": "{speaker}/varRange/close.ogg",
    "range.1": "{speaker}/varRange/1_km.ogg",
    "range.2": "{speaker}/varRange/2_km.ogg",
    "range.3": "{speaker}/varRange/3_km.ogg",
    "range.4": "{speaker}/varRange/4_km.ogg",
    "range.5": "{speaker}/varRange/5_km.ogg",
    "range.6": "{speaker}/varRange/6_km.ogg",
    "range.7": "{speaker}/varRange/7_km.ogg",
    "range.8": "{speaker}/varRange/8_km.ogg",
    "range.9": "{speaker}/varRange/9_km.ogg",
    "range.10": "{speaker}/varRange/10_km.ogg",
    "range.far": "{speaker}/varRange/long.ogg",
    "vertical.above": "{speaker}/varDir/toHigh.ogg",
    "vertical.below": "{speaker}/varDir/toLow.ogg",
    // Placeholders for messages with no recording of their own. Meanings from Windows speech recognition on the
    // English actors (same script, file for file): roger "Roger" 0.70-0.90, trnleft/trnright "turning left/right"
    // 0.61-0.74, rep_trgdestr "target destroyed" 0.61. The other nations are assumed to match; not yet heard.
    "ack": "{speaker}/const/roger.ogg",
    "turn.left": "{speaker}/const/trnleft.ogg",
    "turn.right": "{speaker}/const/trnright.ogg",
    "destroyed": "{speaker}/const/rep_trgdestr.ogg"
  }
